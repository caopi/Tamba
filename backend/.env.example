# Conexão com o MySQL (usuário:senha@host:porta/banco).
# Se a senha tiver @ : # ou /, codifique em URL (@ vira %40).
DATABASE_URL="mysql://tamba:troque-essa-senha@localhost:3306/tamba"

# Segredo usado para assinar o JWT. Troque por um valor longo e aleatório.
# Dica para gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="troque-esse-valor-por-um-segredo-aleatorio"

# Validade do token de acesso (não existe refresh token no projeto)
JWT_EXPIRES_IN="7d"

# Porta da API
PORT=3333

# Origem liberada no CORS (endereço do Vite em desenvolvimento)
CORS_ORIGIN="http://localhost:5173"

# Confirmação de e-mail no cadastro (RGN-01). Com "true", a conta nasce
# inativa, o link sai no terminal da API e o login só funciona depois de
# confirmar. Com "false" (padrão, para desenvolver sem atrito), o cadastro já
# entra logado. A rota de confirmação e o reenvio funcionam nos dois modos.
REQUIRE_EMAIL_VERIFICATION=false

# Cria contas de desenvolvimento no `npm run seed` (admin@tamba.local e mais
# três usuários, senha admin123). Credenciais descartáveis: nunca em produção
# (o seed recusa com NODE_ENV=production).
SEED_DEV_USERS=true

# Endereço do frontend. O link de confirmação de e-mail redireciona para
# <FRONTEND_URL>/verificacao?status=ok|expired|invalid. Sem ela, a API
# responde JSON no próprio link (útil para testar a API sozinha).
FRONTEND_URL="http://localhost:5173"

# Para onde aponta o link do e-mail de confirmação (rota da própria API).
EMAIL_VERIFICATION_URL="http://localhost:3333/api/auth/verify-email"

# Quantos usuários distintos precisam denunciar uma captura para ela ser
# ocultada automaticamente (RGN-14). Na apresentação, 1 facilita a demo.
REPORT_HIDE_THRESHOLD=3

# E-mail da conta que o `npm run seed` promove a admin. O seed NÃO cria a
# conta: cadastre-se pelo app primeiro, confirme o e-mail, preencha aqui e
# só então rode o seed.
ADMIN_EMAIL=""
