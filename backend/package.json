{
  "name": "tamba-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API REST do Tamba - diário de pescarias",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node --env-file=.env src/server.js",
    "migrate": "node --env-file=.env database/migrate.js",
    "seed": "node --env-file=.env database/seed.js",
    "credits": "node database/credits.js",
    "pixel": "node database/thumbs.js --pixel",
    "thumbs": "node database/thumbs.js",
    "icons": "node database/icons.js",
    "pixel-icons": "node database/pixel-icons.js",
    "sprites": "node database/sprites.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "mysql2": "^3.24.3",
    "sharp": "^0.35.5",
    "zod": "^3.24.1"
  }
}
